{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.mutation.config.js"
  },
  "mutate": [
    "src/common/consistent-hash.js",
    "src/common/circuit-breaker.js",
    "src/common/rate-limiter.js",
    "src/common/lru-cache.js",
    "src/common/hash-chain.js",
    "src/common/rbac.js",
    "src/raft/kv-state-machine.js"
  ],
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "thresholds": {
    "high": 85,
    "low": 70,
    "break": 60
  },
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "tempDirName": ".stryker-tmp",
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "ignorePatterns": [
    ".qa-sandbox",
    ".e2e-data",
    "data"
  ]
}
